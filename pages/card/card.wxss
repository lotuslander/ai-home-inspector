.biz{background:linear-gradient(135deg,#007AFF,#5856D6);color:#fff;text-align:center;padding:60rpx 28rpx;border-radius:24rpx;}
.biz-logo{width:200rpx;height:200rpx;border-radius:50%;margin:0 auto;display:block;box-shadow:0 8rpx 24rpx rgba(0,0,0,0.2);}
.biz-name{font-size:40rpx;font-weight:700;margin-top:16rpx;}
.biz-sub{color:rgba(255,255,255,0.8);margin-top:8rpx;}
.biz-line{color:rgba(255,255,255,0.9);margin-top:12rpx;font-size:26rpx;}
.biz-cardno{color:rgba(255,255,255,0.6);margin-top:20rpx;font-size:22rpx;}
.sub-title{font-weight:700;margin-bottom:8rpx;}
.tips{background:#F0F7FF;}

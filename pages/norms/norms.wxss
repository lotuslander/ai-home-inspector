.search{margin:16rpx;padding:20rpx;background:#fff;border-radius:20rpx;}
.title{font-size:30rpx;font-weight:700;}
.pt{padding:8rpx 0;font-size:26rpx;line-height:1.5;}
.hit-bar{margin:0 16rpx 8rpx;font-size:24rpx;color:#007AFF;}
.empty{text-align:center;color:#8E8E93;padding:60rpx 0;}
.code-bar{white-space:nowrap;padding:0 16rpx 12rpx;}
.code-chip{display:inline-block;padding:10rpx 24rpx;background:#fff;border-radius:30rpx;margin-right:12rpx;font-size:24rpx;color:#3C3C43;}
.code-chip.active{background:#007AFF;color:#fff;}
.ai-answer-card{margin:0 16rpx 16rpx;padding:24rpx;background:linear-gradient(135deg,#007AFF,#5856D6);border-radius:16rpx;color:#fff;}
.ai-answer-title{font-size:26rpx;font-weight:700;margin-bottom:12rpx;}
.ai-answer-text{font-size:26rpx;line-height:1.6;white-space:pre-wrap;}
.ai-loading{text-align:center;color:#8E8E93;padding:20rpx;font-size:24rpx;}
.quick-card{margin:0 16rpx 16rpx;background:#fff;border-radius:20rpx;padding:20rpx;}
.quick-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14rpx;}
.quick-title{font-size:28rpx;font-weight:700;}
.quick-fold{font-size:22rpx;color:#007AFF;}
.quick-grid{display:flex;flex-wrap:wrap;gap:12rpx;}
.quick-item{width:calc(50% - 6rpx);box-sizing:border-box;background:#F7F8FA;border-radius:14rpx;padding:16rpx;}
.quick-cat{font-size:22rpx;font-weight:600;color:#007AFF;}
.quick-std{font-size:24rpx;color:#1C1C1E;margin-top:6rpx;line-height:1.5;}
.quick-code{font-size:20rpx;color:#C7C7CC;margin-top:6rpx;}
.quick-hint{font-size:20rpx;color:#C7C7CC;margin-top:14rpx;}
.cat-bar{white-space:nowrap;padding:0 16rpx 12rpx;}
.cat-chip{display:inline-block;padding:10rpx 24rpx;background:#F0F7FF;border-radius:30rpx;margin-right:12rpx;font-size:24rpx;color:#007AFF;border:1rpx solid #D6E8FF;}
.cat-chip.active{background:#007AFF;color:#fff;border-color:#007AFF;}
.local-card{margin-top:12rpx;}
.local-grid{padding:0 24rpx 20rpx;}
.local-item{background:#F9F9FB;border-radius:12rpx;padding:16rpx 20rpx;margin-bottom:12rpx;}
.local-region{font-size:26rpx;font-weight:600;color:#3C3C43;margin-bottom:6rpx;}
.local-code{font-size:20rpx;color:#C7C7CC;font-weight:400;}
.local-pt{font-size:23rpx;color:#666;line-height:1.7;}
.norm-note{font-size:21rpx;color:#B8860B;background:#FFF8E6;padding:8rpx 14rpx;border-radius:10rpx;margin:8rpx 0;line-height:1.6;}

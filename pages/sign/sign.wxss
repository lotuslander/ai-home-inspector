.tip { background: #E5F0FF; color: #007AFF; padding: 16rpx 28rpx; margin: 16rpx; border-radius: 16rpx; font-size: 26rpx; }
.sign-wrap { position: relative; margin: 16rpx; background: #fff; border-radius: 20rpx; overflow: hidden; }
.sign-board { width: 100%; height: 600rpx; }
.sign-hint { position: absolute; left: 0; right: 0; top: 50%; text-align: center; color: #C7C7CC; font-size: 32rpx; pointer-events: none; }

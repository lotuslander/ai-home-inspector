.tip { background: #E5F0FF; color: #007AFF; padding: 16rpx 28rpx; margin: 16rpx; border-radius: 16rpx; font-size: 26rpx; }
.p-name { font-size: 30rpx; font-weight: 600; }
.photo-compare { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.pc-item { flex: 1; text-align: center; }
.pc-label { font-size: 22rpx; color: #8E8E93; margin-bottom: 6rpx; }
.pc-img { width: 100%; height: 200rpx; border-radius: 12rpx; }
.pc-empty { width: 100%; height: 200rpx; border-radius: 12rpx; background: #F2F2F7; display: flex; align-items: center; justify-content: center; color: #C7C7CC; font-size: 24rpx; }
.pc-arrow { color: #8E8E93; font-size: 32rpx; flex-shrink: 0; }
.done-header { font-size: 26rpx; color: #8E8E93; padding: 20rpx 28rpx 0; }
.done-card { opacity: 0.75; }
.group-card { background: #F0F7FF; border: 1rpx solid #D6E9FF; }
/* 整改总览四宫格统计（原来缺样式，数字只能竖排堆叠） */
.stat-row { display: flex; justify-content: space-around; }
.st { text-align: center; flex: 1; }
.st-num { font-size: 36rpx; font-weight: 700; }
.st-lbl { font-size: 20rpx; color: #8E8E93; margin-top: 4rpx; }
.ai-btn { margin-top: 16rpx; padding: 12rpx 0; border-radius: 10rpx; background: #E5F0FF; color: #007AFF; font-size: 24rpx; text-align: center; font-weight: 600; }

.page { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.t-strong { font-size: 32rpx; font-weight: 700; }
.label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.kv { font-size: 24rpx; color: #007AFF; word-break: break-all; }
.input { background: #f2f2f7; border-radius: 12rpx; padding: 20rpx; font-size: 26rpx; }
.btn-primary { background: #007AFF; color: #fff; text-align: center; padding: 24rpx; border-radius: 16rpx; font-size: 30rpx; margin: 20rpx 0; }
.btn-danger { background: #fff; color: #FF3B30; text-align: center; padding: 24rpx; border-radius: 16rpx; font-size: 28rpx; border: 1rpx solid #FF3B30; }

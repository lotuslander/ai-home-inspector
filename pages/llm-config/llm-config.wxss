.page { padding: 20rpx; }
.tip { font-size: 26rpx; color: #666; padding: 20rpx; background: #e8f0fe; border-radius: 12rpx; margin-bottom: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 30rpx; font-weight: 600; }
.badge { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; background: #f2f2f7; color: #999; }
.badge.on { background: #34C759; color: #fff; }
.desc { font-size: 24rpx; color: #666; margin-top: 8rpx; }

.kv-row { display: flex; padding: 8rpx 0; }
.kv-label { color: #666; font-size: 26rpx; width: 160rpx; }
.kv-val { color: #007AFF; font-size: 24rpx; flex: 1; word-break: break-all; }
.step { font-size: 26rpx; line-height: 1.8; padding: 4rpx 0; }

/* 小节标题与提示卡（原来缺样式，标题与正文同样大小） */
.t-strong { font-size: 30rpx; font-weight: 700; color: #1C1C1E; margin-bottom: 12rpx; }
.tip-card { background: #F0F7FF; }

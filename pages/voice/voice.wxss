.warn-card { border: 1rpx solid #FFD9A0; background: #FFF8EE; }
.warn-title { font-size: 30rpx; font-weight: 700; color: #FF9500; }
.rec-card { text-align: center; }
.rec-status { display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.rec-status.on { color: #FF3B30; }
.rec-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #8E8E93; margin-right: 12rpx; }
.rec-dot.pulse { background: #FF3B30; animation: pulse 1.2s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.7); } }
.rec-btn-row { display: flex; gap: 20rpx; }
.draft-item { border-bottom: 1rpx solid #F2F2F7; padding: 16rpx 0; }
.draft-item:last-child { border-bottom: none; }
.draft-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.draft-body { font-size: 27rpx; color: #1C1C1E; line-height: 1.5; }
.tip-card { background: #F0F7FF; }
.tip-line { font-size: 26rpx; color: #3C3C43; margin: 8rpx 0; }
.tip-ex { color: #007AFF; font-weight: 500; }
.trans-status { margin-top: 16rpx; font-size: 25rpx; color: #007AFF; background: #E5F0FF; border-radius: 12rpx; padding: 14rpx 20rpx; text-align: left; }
.op-row { margin-top: 10rpx; }
.op-btn { display: inline-block; font-size: 24rpx; padding: 8rpx 22rpx; border-radius: 26rpx; }
.op-btn.danger { background: #FFEBEB; color: #FF3B30; }

/* 任务条与强调文字（原来缺样式，标题与正文无区分） */
.task-bar { background: #E5F0FF; }
.t-strong { font-size: 30rpx; font-weight: 700; color: #1C1C1E; margin-bottom: 4rpx; }

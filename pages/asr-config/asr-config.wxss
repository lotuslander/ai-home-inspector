.field { margin-bottom: 22rpx; }
.f-label { font-size: 26rpx; color: #3C3C43; font-weight: 600; margin-bottom: 10rpx; }
.f-input { background: #F2F2F7; border-radius: 14rpx; padding: 18rpx 24rpx; font-size: 28rpx; }
.type-row { display: flex; gap: 14rpx; }
.type-btn { flex: 1; text-align: center; font-size: 26rpx; padding: 16rpx 0; border-radius: 12rpx; background: #F2F2F7; color: #3C3C43; border: 2rpx solid transparent; }
.type-btn.on { background: #E5F0FF; color: #007AFF; border-color: #007AFF; font-weight: 600; }
.tip-box { background: #F0F7FF; border-radius: 14rpx; padding: 18rpx 22rpx; margin: 6rpx 0 24rpx; }
.tip-line { font-size: 24rpx; color: #3C3C43; line-height: 1.7; margin: 4rpx 0; }
.tip-ex { color: #007AFF; }
.guide-box { background: #FFF8E6; border-radius: 14rpx; padding: 18rpx 22rpx; margin: 6rpx 0 24rpx; }
.guide-title { font-size: 26rpx; color: #B8860B; font-weight: 600; }
.guide-body { margin-top: 12rpx; }
.guide-step { font-size: 24rpx; color: #8E6E2E; line-height: 1.7; margin: 8rpx 0; }
.btn-row { display: flex; gap: 20rpx; }
